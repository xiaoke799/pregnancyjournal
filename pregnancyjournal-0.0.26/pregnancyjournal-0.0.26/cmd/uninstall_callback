#!/bin/bash
# 孕程记 - 卸载时根据用户选择处理数据
LOG_FILE="${TRIM_TEMP_LOGFILE:-/tmp/pregnancyjournal-uninstall.log}"
mkdir -p "$(dirname "${LOG_FILE}")" 2>/dev/null

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null
}

case "${wizard_data_action}" in
    delete)
        log_msg "User chose to delete all data"
        rm -rf "${TRIM_PKGVAR}" 2>/dev/null
        ;;
    keep|"")
        log_msg "User chose to keep data, cleaning runtime only"
        rm -f "${TRIM_PKGVAR}/app.pid" 2>/dev/null
        rm -f "${TRIM_PKGVAR}/info.log" 2>/dev/null
        ;;
    *)
        log_msg "Unknown action: ${wizard_data_action}, defaulting to keep"
        ;;
esac
exit 0
