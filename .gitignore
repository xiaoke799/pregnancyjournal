# ===========================================
# 孕程记 (pregnancy-journal) .gitignore
# 注意：应用已上移至仓库根目录（app/ cmd/ config/ wizard/ frontend/ ui/ …）
# ===========================================

# ---- 构建产物与打包 ----
*.fpk
app.tgz
*.tar.gz
_fpk_work/
_verify_extract/
.fpk-temp/
build/

# ---- 前端构建产物（vite build 输出，可重新生成）----
app/ui/assets/
app/ui/index.html
app/ui/favicon.png
app/ui/images/
ui/assets/
ui/index.html
ui/favicon.png
ui/images/

# ---- 前端历史重复产物 ----
app/www/

# ---- 数据库与运行时数据 ----
# 仓库根的 data/ 是本地开发运行时目录（STORAGE_DIR 在无环境变量时兜底为 <cwd>/data），
# 里面是本地数据库与运行状态，一律不入库。
/data/
*.db
*.db-shm
*.db-wal

# ---- Node / 前端依赖 ----
node_modules/

# ---- Python ----
.venv/
__pycache__/
*.pyc
paddleocr-env/

# ---- 日志 ----
*.log
logs/
npm-debug.log*
日志/

# ---- 部署凭据文件（绝不入库）----
ssh_pass.py
sftp_batch.txt
paramiko_debug.log
deploy_*.py

# ---- 作者本人的收款码图片（个人支付码，绝不入库）----
# 这两张图只留在本机，vite 构建会从 frontend/public/images/ 拷进 app/ui/images/ 并打进 fpk。
# 从仓库克隆出来后重新构建不会有它们，界面会自动隐藏该区块（见 SettingsView 的 donateFailed）。
frontend/public/images/donation_*.png

# ---- 环境变量与密钥 ----
.env
.env.*
!.env.example

# ---- 测试 / 备份数据（含用户隐私）----
test-backup-data/
test_data/
backup-*/
*.sql

# ---- 模板截图 / 本机工具配置 ----
muban.png
.mcp.json

# ---- vite 临时文件 ----
vite.config.ts.timestamp-*

# ===========================================
# 以下为「非本项目内容」拦截区
# 工作区里长期堆积了他项目残留 / 参考文档 / 历史备份 / 第三方脚手架，
# 一律不入库，避免 git add -A 误提交。
# ===========================================

# ---- 他项目残留（不属于孕程记）----
/.meituan-catpaw/
/mempalace.yaml
/mxcp-site.yml
/entities.json

# ---- 第三方参考文档与脚手架（仅本地查阅）----
/飞牛开发文档及脚手架/
/fnnas-docs-main/
/已上架项目/
/.trae-cn/

# ---- 历史备份 / 旧版本解包（体积大，仅本地留档）----
/package/
/pregnancyjournal备份/
/pregnancyjournal备份.zip
/pregnancyjournal_废弃_0904/
/pregnancyjournal_废弃_*/
/pregnancyjournal-0.0.*/
/pregnancyjournal-0.0.*.zip

# ---- fnpack 工具二进制（本地打包要用，但不入库）----
/fnpack*

# ---- 一次性临时脚本 ----
/_*.js
/_*.py
/_*.ps1
/round*.ps1
/update-remote-*.ps1

# ---- 项目内部资料（含大体积 fpk 与 git bundle，不入库）----
/.workbuddy/

# ---- 本地留档的踩坑文档（暂不入库）----
/DEPLOY_NOTES.md
/WEBSOCKET_FIX.md

# ---- 系统文件 / IDE ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ===========================================
# 反向例外：明确禁止
# 历史上本目录曾有一行 `!server/node/node_modules/`，本意是"依赖也提交，
# 省得安装时 npm install"，实际上把一份重复后端的上万个依赖文件从忽略里
# 放了出来 —— 一次 git add -A 就会全部提交。
# node_modules 永远不入库：后端依赖由 build.ps1 现场 npm install 并打进 app.tgz。
# 不要在本文件里再加任何 `!...node_modules...` 形式的例外。
# ===========================================
