#!/bin/bash
# 孕程记 - 安装后回调
LOG_FILE="${TRIM_TEMP_LOGFILE:-/tmp/pregnancy-journal-install.log}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null
}

log_msg "Installation callback started"

NODE_BIN="/var/apps/nodejs_v22/target/bin"
export PATH=${NODE_BIN}:$PATH

NODE_DIR="${TRIM_APPDEST}/server/node"

if [ -d "${NODE_DIR}" ]; then
    log_msg "Installing Node.js dependencies in ${NODE_DIR}..."
    cd "${NODE_DIR}" || { log_msg "ERROR: cannot cd to ${NODE_DIR}"; exit 0; }
    npm install --production >> "${LOG_FILE}" 2>&1 && log_msg "npm install completed" || log_msg "WARNING: npm install failed or skipped"
else
    log_msg "WARNING: Node.js directory not found at ${NODE_DIR}"
fi

log_msg "Installation callback completed"
exit 0
