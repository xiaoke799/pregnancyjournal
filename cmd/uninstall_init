#!/bin/bash
# 孕程记 - 卸载【前】数据抢救
#
# 【为什么必须在这里做】
# 卸载流程 = 停止应用 -> 删除安装目录 ${TRIM_APPDEST} -> uninstall_callback。
# uninstall_init 是「删除安装目录之前」唯一的钩子。
#
# v0.0.27 及更早版本的 config.js 里，除 DATABASE_PATH 外的所有业务目录都回退到
# process.cwd()/data，而 cmd/main 会 cd 到 ${TRIM_APPDEST}/server/node，
# 因此用户数据（相册/产检照片、产检报告、日记图片、视频、缩略图、备份…）
# 实际都写在【安装目录】下：${TRIM_APPDEST}/server/node/data
#
# 用户在应用中心卸载时，即使选了「保留数据」，uninstall_callback 也只能保住
# ${TRIM_PKGVAR}（数据库在那里），保不住安装目录里的照片 —— 卸载会把照片一起删掉。
# 2026-09-25 真实事故：用户「卸载后重装」，相册全丢，数据库里的记录还在，
# 点开照片全是 404（记录指向的文件已随安装目录删除）。
#
# 所以：在【删除安装目录之前】把旧目录里的用户数据复制到持久目录 ${TRIM_PKGVAR}/data。
# 此后即使用户选择「卸载重装」，照片仍在持久区，重装后即可正常显示。
#
# 【铁律】（与 upgrade_init 保持一致）
#   - 只复制，绝不删除、绝不移动源文件
#   - 不覆盖持久目录里已存在的同名文件（-n），保证幂等、不破坏新数据
#   - 不复制数据库本体与日志（数据库本来就在 var 里，避免用旧库覆盖正在用的库）
#   - 任何失败都容忍，始终 exit 0 —— 卸载绝不能因为抢救动作而中断

LOG_FILE="${TRIM_PKGVAR:-/tmp}/info.log"
mkdir -p "$(dirname "${LOG_FILE}")" 2>/dev/null

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - uninstall_init: $1" >> "${LOG_FILE}" 2>/dev/null
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') - uninstall_init: $1" >> "${TRIM_TEMP_LOGFILE}" 2>/dev/null
    fi
}

# 用户明确选择「删除所有数据」时无需抢救（后面 uninstall_callback 会 rm -rf 持久目录）。
# 变量取不到时按 keep 处理，宁可多复制一次也不丢数据。
if [ "${wizard_data_action:-keep}" = "delete" ]; then
    log_msg "用户已选择删除所有数据，跳过抢救"
    exit 0
fi

LEGACY="${TRIM_APPDEST}/server/node/data"
SAFE="${TRIM_PKGVAR}/data"

log_msg "开始卸载前数据抢救"
log_msg "旧数据目录: ${LEGACY}"
log_msg "持久目录:   ${SAFE}"

if [ ! -d "${LEGACY}" ]; then
    log_msg "旧数据目录不存在，跳过（新版应用数据本就在持久目录）"
    exit 0
fi

mkdir -p "${SAFE}" 2>/dev/null

copied=0
for entry in "${LEGACY}"/* "${LEGACY}"/.[!.]*; do
    [ -e "${entry}" ] || continue
    name="$(basename "${entry}")"
    case "${name}" in
        *.db|*.db-wal|*.db-shm) continue ;;   # 数据库本体留在 var，别被旧库覆盖
        *.jsonl|*.log)          continue ;;   # 日志无迁移价值
        *.js)                   continue ;;   # 打包时误混入的开发脚本
        # 随包发布的只读知识库（旧版把内置资源与可写目录混在一起），不是用户数据
        recipes.json|food_safety_v3.json|checkup_schedule.json|checkup_subitem_aliases.json) continue ;;
        default_checklist_*.json) continue ;;
    esac
    if [ -d "${entry}" ]; then
        cp -an "${entry}" "${SAFE}/" 2>/dev/null && copied=$((copied + 1))
    elif [ -f "${entry}" ]; then
        cp -an "${entry}" "${SAFE}/" 2>/dev/null && copied=$((copied + 1))
    fi
done

# 抢救过来的文件可能仍带旧属主；确保应用运行用户可读写。
if [ -n "${TRIM_USERNAME:-}" ]; then
    chown -R "${TRIM_USERNAME}" "${SAFE}" 2>/dev/null \
        || log_msg "WARNING: chown 失败（不影响本次卸载）"
fi

log_msg "抢救完成：处理 ${copied} 项 -> ${SAFE}"
exit 0
