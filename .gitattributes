# 默认自动处理
* text=auto

# shell脚本必须LF（Linux执行依赖，CRLF会导致 exec format error）
pregnancyjournal/cmd/* text eol=lf
pregnancyjournal/app/cmd/* text eol=lf
*.sh text eol=lf

# Windows批处理必须CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不转换
*.png binary
*.jpg binary
*.ico binary
*.fpk binary
*.tgz binary
*.db binary
