{
  "name": "fnos-app-template",
  "version": "0.1.1",
  "description": "Open-source fnOS Native app template powered by Nitro",
  "type": "module",
  "workspaces": [
    "packages/ui",
    "packages/server",
    "packages/assets"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --config packages/ui/vite.config.ts",
    "dev:server": "node scripts/dev.mjs",
    "build:web": "vite build --config packages/ui/vite.config.ts",
    "build": "npm run build:web && nitro build",
    "start": "node scripts/start.mjs",
    "download:fnpack": "node scripts/download-fnpack.mjs",
    "prepare:package": "node scripts/prepare-package.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "pack:app": "npm run build && npm run prepare:package && bash scripts/pack-app.sh && npm run validate:package",
    "pack:fpk": "npm run pack:app && bash scripts/pack-fpk.sh"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.2.1",
    "nitro": "3.0.260610-beta",
    "vite": "^8.0.16",
    "vue": "^3.5.38"
  }
}
